{
  "name": "fractal",
  "version": "0.5.5",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "apps/desktop/main.cjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build -w @fractal/shared && npm run build -w @fractal/ui && npm run build -w @fractal/hub",
    "test": "npm run test -w @fractal/shared && npm run test -w @fractal/hub && npm run test -w @fractal/ui",
    "typecheck": "npm run typecheck -w @fractal/shared && npm run typecheck -w @fractal/hub && npm run typecheck -w @fractal/ui",
    "hub": "tsx packages/hub/src/main.ts",
    "dev": "node scripts/dev.mjs",
    "desktop:build": "npm run build && node scripts/build-desktop.mjs && node scripts/generate-licenses.mjs",
    "desktop": "npm run desktop:build && electron .",
    "desktop:dist": "npm run desktop:dist:win",
    "e2e": "tsx scripts/e2e.ts",
    "format": "prettier --write \"packages/**/*.{ts,tsx,css,json}\" \"scripts/**\" \"apps/desktop/**/*.{js,cjs,ts}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,css,json}\" \"scripts/**\" \"apps/desktop/**/*.{js,cjs,ts}\"",
    "tokens": "node scripts/gen-tokens.mjs",
    "desktop:dist:win": "npm run desktop:build && electron-builder --config scripts/release-config.cjs --win nsis --x64 --publish never",
    "desktop:dist:linux": "npm run desktop:build && electron-builder --config scripts/release-config.cjs --linux AppImage deb --x64 --publish never",
    "desktop:dist:mac": "npm run desktop:build && node scripts/build-mac-release.mjs",
    "release:verify": "node scripts/verify-release-version.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "app.newspapers.desktop",
    "productName": "News Papers",
    "executableName": "news-papers",
    "directories": {
      "output": "dist/installer"
    },
    "files": [
      "apps/desktop/main.cjs",
      "apps/desktop/preload.cjs",
      "apps/desktop/data-migration.cjs",
      "apps/desktop/assets/**",
      "apps/desktop/dist/**",
      "packages/ui/dist/**",
      "node_modules/@lydell/node-pty/**",
      "node_modules/@lydell/node-pty-*/**",
      "node_modules/argparse/**",
      "node_modules/builder-util-runtime/**",
      "node_modules/debug/**",
      "node_modules/electron-updater/**",
      "node_modules/electron-updater/node_modules/semver/**",
      "node_modules/semver/**",
      "node_modules/fs-extra/**",
      "node_modules/graceful-fs/**",
      "node_modules/js-yaml/**",
      "node_modules/jsonfile/**",
      "node_modules/lazy-val/**",
      "node_modules/lodash.escaperegexp/**",
      "node_modules/lodash.isequal/**",
      "node_modules/ms/**",
      "node_modules/sax/**",
      "node_modules/tiny-typed-emitter/**",
      "node_modules/universalify/**",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "apps/desktop/dist/pdf-extraction.worker.mjs",
      "apps/desktop/dist/pdf.worker.mjs",
      "node_modules/@lydell/node-pty-*/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "apps/desktop/assets/fractal.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "installerIcon": "apps/desktop/assets/fractal.ico",
      "uninstallerIcon": "apps/desktop/assets/fractal.ico"
    },
    "mac": {
      "executableName": "News Papers",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "apps/desktop/assets/fractal.icns"
    },
    "artifactName": "News-Papers-${version}-${os}-${arch}.${ext}",
    "deb": {
      "packageName": "news-papers"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "apps/desktop/assets/icon-512.png",
      "category": "Education",
      "maintainer": "News Papers contributors"
    },
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "licenses/LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "licenses/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "dist/licenses/desktop-third-party.txt",
        "to": "licenses/desktop-third-party.txt"
      }
    ]
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "electron-updater": "^6.8.9"
  },
  "description": "Research reader, library and discovery desk",
  "license": "Apache-2.0",
  "homepage": "https://github.com/iwantgobackhome/news-papers"
}
