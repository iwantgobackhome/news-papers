{
  "name": "@fractal/hub",
  "version": "0.5.5",
  "private": true,
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./src/main.ts",
  "exports": {
    ".": {
      "types": "./src/main.ts",
      "default": "./dist/index.mjs"
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run typecheck && node ../../scripts/build-hub.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fractal/shared": "0.5.5",
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.13",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4"
  }
}
